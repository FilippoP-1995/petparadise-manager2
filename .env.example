# Variabili d'ambiente per lo sviluppo locale della V1 (app.py).
#
# app.py legge le variabili direttamente da os.environ (nessun caricamento
# automatico di questo file - stesso comportamento gia' in uso per
# WHATSAPP_ACCESS_TOKEN, SMTP_*, VAPID_*, ecc.): per usarle in locale vanno
# esportate nella shell prima di avviare il server, ad esempio:
#   set -a && source .env && set +a && python app.py
# oppure impostate una per una nel proprio terminale/IDE.
#
# In produzione (Render) le stesse variabili si configurano come
# Environment Variable del servizio, non tramite questo file - vedi
# render.yaml.

# Chiave API di Anthropic, necessaria perche' l'Assistente AI del
# gestionale possa rispondere. Senza questa variabile l'endpoint
# /api/assistente/chat risponde con un errore esplicito invece di
# inventare una risposta.
ANTHROPIC_API_KEY=
